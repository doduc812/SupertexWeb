@model dynamic
@{
    ViewData["Title"] = "Tổng quan hệ thống";
    Layout = "_AdminLayout";

    // Lấy dữ liệu thật được truyền từ Controller qua ViewBag hoặc Model
    int totalProducts = ViewBag.TotalProducts ?? 0;
    int totalRequests = ViewBag.TotalRequests ?? 0;
    int totalPosts = ViewBag.TotalPosts ?? 0;
    var recentRequests = ViewBag.RecentRequests as List<SupertexWeb.Models.CustomerRequest> ?? new List<SupertexWeb.Models.CustomerRequest>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Tổng quan hệ thống</h2>
        <p class="text-muted small mb-0">Chào mừng bạn trở lại hệ thống quản trị Supertex.</p>
    </div>
    <div>
        <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-2 rounded-pill fw-semibold">
            <i class="fa-solid fa-circle-check me-1"></i> Hệ thống hoạt động bình thường
        </span>
    </div>
</div>

<!-- CÁC THẺ THỐNG KÊ SỐ LIỆU THẬT -->
<div class="row g-4 mb-4">
    <!-- Tổng sản phẩm -->
    <div class="col-xl-3 col-md-6">
        <a href="/Admin/Products" class="text-decoration-none">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white hover-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Tổng sản phẩm</span>
                        <h2 class="fw-bold text-dark mt-1 mb-0">@totalProducts</h2>
                        <span class="text-success extra-small fw-semibold"><i class="fa-solid fa-arrow-up me-1"></i>Đang quản lý trong kho</span>
                    </div>
                    <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3 fs-4">
                        <i class="fa-solid fa-box-archive"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Yêu cầu báo giá mới -->
    <div class="col-xl-3 col-md-6">
        <a href="/Admin/CustomerRequests" class="text-decoration-none">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white hover-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Yêu cầu báo giá / Mẫu</span>
                        <h2 class="fw-bold text-dark mt-1 mb-0">@totalRequests</h2>
                        <span class="text-danger extra-small fw-semibold"><i class="fa-solid fa-bell me-1"></i>Cần xử lý từ khách</span>
                    </div>
                    <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3 fs-4">
                        <i class="fa-solid fa-envelope-open-text"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Bài viết hoạt động -->
    <div class="col-xl-3 col-md-6">
        <a href="/Admin/Posts" class="text-decoration-none">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white hover-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Bài viết hoạt động</span>
                        <h2 class="fw-bold text-dark mt-1 mb-0">@totalPosts</h2>
                        <span class="text-success extra-small fw-semibold"><i class="fa-solid fa-globe me-1"></i>Đã xuất bản lên web</span>
                    </div>
                    <div class="p-3 bg-success bg-opacity-10 text-success rounded-3 fs-4">
                        <i class="fa-solid fa-newspaper"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Thị trường xuất khẩu -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Thị trường xuất khẩu</span>
                    <h4 class="fw-bold text-dark mt-1 mb-0">3 Khu vực</h4>
                    <span class="text-secondary extra-small">Japan, US, EU</span>
                </div>
                <div class="p-3 bg-info bg-opacity-10 text-info rounded-3 fs-4">
                    <i class="fa-solid fa-earth-americas"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- DANH SÁCH YÊU CẦU MỚI NHẤT TỪ DATABASE -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0">Yêu cầu mới nhất từ khách hàng</h5>
                <a href="/Admin/CustomerRequests" class="btn btn-sm btn-outline-primary rounded-pill px-3">Xem tất cả</a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase extra-small fw-bold">
                        <tr>
                            <th class="py-3">Khách hàng / Công ty</th>
                            <th class="py-3">Loại yêu cầu</th>
                            <th class="py-3">Thời gian</th>
                            <th class="py-3 text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (recentRequests != null && recentRequests.Any())
                        {
                            foreach (var req in recentRequests)
                            {
                                <tr>
                                    <td>
                                        <h6 class="fw-bold text-dark mb-0">@req.CustomerName</h6>
                                        <span class="text-muted small">@req.Email</span>
                                    </td>
                                    <td>
                                        @if (req.RequestType == "Quote")
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary px-2.5 py-1 rounded-pill extra-small">Báo giá (RFQ)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success px-2.5 py-1 rounded-pill extra-small">Nhận mẫu</span>
                                        }
                                    </td>
                                    <td class="small text-secondary">@req.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end">
                                        <a href="/Admin/CustomerRequests" class="btn btn-sm btn-outline-primary rounded-3 px-3">Xem chi tiết</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted small">Chưa có yêu cầu nào từ khách hàng.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- LỐI TẮT THAO TÁC NHANH (ĐÃ ĐƯỢC PHỐI MÀU & ĐÍNH KÈM LINK CHUẨN) -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
            <h5 class="fw-bold text-dark mb-3">Lối tắt thao tác nhanh</h5>
            <div class="d-flex flex-column gap-3">
                <a href="/Admin/Create" class="btn btn-primary py-3 px-3 rounded-3 fw-semibold text-start shadow-sm d-flex align-items-center justify-content-between">
                    <span><i class="fa-solid fa-circle-plus me-2"></i> Thêm sản phẩm mới</span>
                    <i class="fa-solid fa-arrow-right small"></i>
                </a>
                <a href="/Admin/Posts" class="btn btn-outline-dark py-3 px-3 rounded-3 fw-semibold text-start d-flex align-items-center justify-content-between bg-light border-0">
                    <span><i class="fa-solid fa-pen-to-square me-2 text-primary"></i> Đăng bài viết hoạt động</span>
                    <i class="fa-solid fa-arrow-right small text-muted"></i>
                </a>
                <a href="/Admin/Hero" class="btn btn-outline-dark py-3 px-3 rounded-3 fw-semibold text-start d-flex align-items-center justify-content-between bg-light border-0">
                    <span><i class="fa-solid fa-image me-2 text-success"></i> Đổi ảnh Banner / Hero</span>
                    <i class="fa-solid fa-arrow-right small text-muted"></i>
                </a>
                <a href="/Admin/CustomerRequests" class="btn btn-outline-dark py-3 px-3 rounded-3 fw-semibold text-start d-flex align-items-center justify-content-between bg-light border-0">
                    <span><i class="fa-solid fa-headset me-2 text-warning"></i> Quản lý yêu cầu khách hàng</span>
                    <i class="fa-solid fa-arrow-right small text-muted"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-card {
        transition: all 0.2s ease;
    }

        .hover-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.08) !important;
        }
</style>