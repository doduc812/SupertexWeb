@model SupertexWeb.Models.Post

@{
    var isAdd = (Model == null || Model.Id == 0);
    ViewData["Title"] = isAdd ? "Viết bài mới" : "Chỉnh sửa bài viết";
    Layout = "_AdminLayout";
}

<!-- Nhúng thư viện Summernote WYSIWYG Editor & Bootstrap Icons (CSS & JS từ CDN) -->
<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" rel="stylesheet">

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold text-dark mb-1">
                    <i class="fa-solid @(isAdd ? "fa-pen-nib" : "fa-pen-to-square") text-primary me-2"></i>
                    @(isAdd ? "Viết bài viết mới" : "Chỉnh sửa bài viết")
                </h2>
            </div>
            <a href="/Admin/Posts" class="btn btn-outline-secondary btn-sm">
                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <form asp-action="Upsert" method="post" enctype="multipart/form-data">

                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ImageUrl" />
                    <input type="hidden" asp-for="PublishedDate" />

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Tiêu đề bài viết</label>
                        <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề bài viết..." />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Summary" class="form-label fw-semibold">Tóm tắt ngắn (Sapo)</label>
                        <textarea asp-for="Summary" class="form-control" rows="2" placeholder="Tóm tắt ngắn gọn hiển thị ở trang chủ..."></textarea>
                    </div>

                    <!-- Ô NỘI DUNG CHI TIẾT TÍCH HỢP SUMMERNOTE WYSIWYG -->
                    <div class="mb-3">
                        <label asp-for="Content" class="form-label fw-semibold">Nội dung chi tiết bài viết</label>
                        <!-- Textarea sẽ được biến đổi thành khung soạn thảo trực quan -->
                        <textarea asp-for="Content" id="summernote" class="form-control"></textarea>
                    </div>

                    <!-- Khu vực Ảnh đại diện chính (Cover Image) -->
                    <div class="row g-3 mb-4 p-3 bg-light rounded-4 border">
                        @if (!string.IsNullOrEmpty(Model?.ImageUrl))
                        {
                            <div class="col-md-4 text-center">
                                <label class="form-label fw-semibold d-block text-start small">Ảnh đại diện hiện tại</label>
                                <img src="@Model.ImageUrl" alt="" class="rounded object-fit-cover shadow-sm w-100" style="height: 110px;" />
                            </div>
                        }
                        <div class="@(string.IsNullOrEmpty(Model?.ImageUrl) ? "col-md-12" : "col-md-8")">
                            <label class="form-label fw-semibold">Tải lên hình ảnh đại diện chính (Cover Image ngoài trang chủ)</label>
                            <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        </div>
                    </div>

                    <div class="mb-4 form-check">
                        <input type="checkbox" asp-for="IsPublished" class="form-check-input" />
                        <label class="form-check-label fw-semibold" asp-for="IsPublished">Công khai bài viết ngay lên website</label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary py-2.5 fw-semibold shadow-sm">
                            <i class="fa-solid fa-floppy-disk me-2"></i> @(isAdd ? "Đăng bài viết mới" : "Lưu thay đổi bài viết")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Nhúng JavaScript của Summernote -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>

<script>
    $(document).ready(function() {
        $('#summernote').summernote({
            placeholder: 'Soạn thảo nội dung bài viết tại đây...',
            tabsize: 2,
            height: 400, // Chiều cao khung soạn thảo
            toolbar: [
                ['style', ['style']],
                ['font', ['bold', 'italic', 'underline', 'clear']],
                ['para', ['ul', 'ol', 'paragraph']],
                ['insert', ['picture', 'video', 'link']],
                ['view', ['codeview', 'help']]
            ],
            // Khi người dùng chọn ảnh từ máy tính để chèn vào bài viết
            callbacks: {
                onImageUpload: function(files) {
                    for (let i = 0; i < files.length; i++) {
                        uploadImageAndInsert(files[i]);
                    }
                }
            }
        });
    });

    // Hàm gửi ảnh lên Server (lưu vào thư mục PostNews) rồi tự động nhúng ảnh hiển thị thẳng vào khung soạn thảo
    function uploadImageAndInsert(file) {
        let formData = new FormData();
        formData.append("upload", file);

        $.ajax({
            url: '/Admin/UploadEditorImage',
            method: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(response) {
                if (response.success) {
                    // Chèn ảnh hiển thị trực tiếp ngay tại vị trí con trỏ chuột
                    $('#summernote').summernote('insertImage', response.url);
                } else {
                    alert("Lỗi upload ảnh: " + response.message);
                }
            },
            error: function() {
                alert("Có lỗi xảy ra khi tải ảnh lên server.");
            }
        });
    }
</script>