@model SupertexWeb.Models.AboutPage

@{
    ViewData["Title"] = "Hồ sơ năng lực & Nhà máy Supertex - OEM/ODM Global";
}

<link rel="stylesheet" href="~/css/index-style.css" />

<!-- 1. NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top shadow-sm border-bottom py-2">
    <div class="container">
        <a class="navbar-brand fw-bold text-dark d-flex align-items-center gap-2 py-0" href="/">
            <img src="~/images/partners/supertex-logo.svg" alt="Supertex Logo" width="38" class="img-fluid" />
            <span class="fs-5">SUPERTEX <span class="text-primary fs-6 fw-normal">Socks & Textile</span></span>
        </a>
        <div class="d-flex align-items-center gap-3">
            <a href="/" class="btn btn-outline-secondary btn-sm px-3 rounded-pill">&larr; Về trang chủ</a>
            <a href="/#contact" class="btn btn-dark btn-sm px-3 rounded-pill">Liên hệ hợp tác</a>
        </div>
    </div>
</nav>

<!-- 2. HERO HEADER CHO TRANG GIỚI THIỆU -->
<section class="py-5 bg-light border-bottom text-center">
    <div class="container py-3" style="max-width: 800px;">
        <span class="text-uppercase text-primary fw-bold extra-small tracking-wider">HỒ SƠ NĂNG LỰC DOANH NGHIỆP</span>
        <h1 class="fw-bold text-dark mt-2 mb-3">@(Model.Title ?? "Năng Lực & Quy Mô Sản Xuất Supertex")</h1>
        <p class="text-secondary lead fs-6 mb-0">
            @(Model.Subtitle ?? "Hệ thống nhà máy hiện đại cùng quy trình kiểm soát chất lượng chuẩn quốc tế")
        </p>
    </div>
</section>

<!-- 3. NỘI DUNG CHÍNH & ẢNH MINH CHỨNG -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row align-items-center justify-content-between g-5">
            <!-- Cột trái: Bài viết giới thiệu sâu -->
            <div class="col-lg-7">
                <h3 class="fw-bold text-dark mb-4">Tổng quan về hệ thống sản xuất Supertex</h3>
                <div class="text-secondary lh-lg mb-4" style="text-align: justify;">
                    @Html.Raw(SupertexWeb.Services.RichTextSanitizer.Sanitize(Model.MainContent)?.Replace("\n", "<br />"))
                </div>

                <div class="p-4 bg-light rounded-4 border-start border-4 border-primary shadow-sm">
                    <h5 class="fw-bold text-dark h6 mb-2">Cam kết định hướng xuất khẩu</h5>
                    <p class="text-muted small mb-0">
                        Chúng tôi không ngừng tối ưu hóa chi phí sản xuất, nâng cao năng suất dệt và tuân thủ tuyệt đối các quy định khắt khe về an toàn lao động cũng như bảo vệ môi trường theo tiêu chuẩn toàn cầu.
                    </p>
                </div>
            </div>

            <!-- Cột phải: Hình ảnh thực tế nhà máy kèm chú thích chứng minh -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-light">
                    @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                    {
                        <img src="@Model.MainImageUrl" alt="Nhà máy Supertex" class="w-100 object-fit-cover" style="max-height: 400px;" />
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">Không có hình ảnh</div>
                    }
                    <div class="card-body p-3 text-center bg-white border-top">
                        <span class="text-muted extra-small fst-italic">
                            📷 Hình ảnh thực tế: Dây chuyền máy dệt kim tự động và khu vực kiểm tra QC tại nhà máy Supertex.
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 4. KHU VỰC CÁC TIÊU CHUẨN & CHỨNG NHẬN QUỐC TẾ (CHỨNG MINH NĂNG LỰC) -->
<section class="py-5 bg-light border-top border-bottom">
    <div class="container">
        <div class="text-center mb-5">
            <span class="text-uppercase text-primary fw-bold extra-small tracking-wider">QUALITY ASSURANCE</span>
            <h3 class="fw-bold text-dark mt-1">Tiêu Chuẩn Chất Lượng & Chứng Nhận Quốc Tế</h3>
            <p class="text-muted small">Nền tảng vững chắc giúp sản phẩm tự tin chinh phục các thị trường khó tính nhất</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                    <div class="fs-1 mb-2 text-primary">📜</div>
                    <h5 class="fw-bold text-dark h6">@Model.Standard1Title</h5>
                    <p class="text-secondary small mb-0">@Model.Standard1Desc</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                    <div class="fs-1 mb-2 text-success">🌿</div>
                    <h5 class="fw-bold text-dark h6">@Model.Standard2Title</h5>
                    <p class="text-secondary small mb-0">@Model.Standard2Desc</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                    <div class="fs-1 mb-2 text-dark">🛡️</div>
                    <h5 class="fw-bold text-dark h6">@Model.Standard3Title</h5>
                    <p class="text-secondary small mb-0">@Model.Standard3Desc</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 5. CTA LIÊN HỆ HỢP TÁC -->
<section class="py-5 bg-white text-center">
    <div class="container" style="max-width: 700px;">
        <h3 class="fw-bold text-dark mb-3">Bạn muốn tham quan nhà máy hoặc đặt mẫu thử OEM?</h3>
        <p class="text-secondary small mb-4">Đội ngũ kỹ thuật và kinh doanh của Supertex luôn sẵn sàng đón tiếp các đối tác đến tham quan trực tiếp hoặc gửi mẫu sample theo yêu cầu.</p>
        <a href="/#contact" class="btn btn-primary px-4 py-2.5 rounded-3 fw-semibold shadow-sm">Gửi yêu cầu hợp tác ngay</a>
    </div>
</section>