@model SupertexWeb.Models.Product

@{
    ViewData["Title"] = $"{Model.Name} ({Model.Code}) - Supertex OEM/ODM";
    var relatedProducts = ViewBag.RelatedProducts as List<SupertexWeb.Models.Product>;
}

<link rel="stylesheet" href="~/css/index-style.css" />

<!-- 1. THANH ĐIỀU HƯỚNG (ĐỒNG BỘ TRANG CHỦ) -->
<nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top shadow-sm border-bottom py-2">
    <div class="container">
        <a class="navbar-brand fw-bold text-dark d-flex align-items-center gap-2 py-0" href="/">
            <img src="~/images/partners/supertex-logo.svg" alt="Supertex Logo" width="38" class="img-fluid" />
            <span class="fs-5">SUPERTEX <span class="text-primary fs-6 fw-normal">Socks & Textile</span></span>
        </a>
        <div class="d-none d-md-flex align-items-center gap-4">
            <a href="/#partners" class="text-decoration-none text-secondary small fw-medium nav-link-custom">Đối tác</a>
            <a href="/#products-grid" class="text-decoration-none text-secondary small fw-medium nav-link-custom">Sản phẩm</a>
            <a href="/#about-us" class="text-decoration-none text-secondary small fw-medium nav-link-custom">Giới thiệu</a>
            <a href="/#company-news" class="text-decoration-none text-secondary small fw-medium nav-link-custom">Hoạt động</a>
        </div>
        <div class="d-flex align-items-center gap-3">
            <a href="/#products-grid" class="btn btn-outline-secondary btn-sm px-3 rounded-pill">&larr; Danh mục</a>
            <a href="/Home/RequestQuote?code=@Model.Code" class="btn btn-dark btn-sm px-3 rounded-pill">Yêu cầu báo giá</a>
        </div>
    </div>
</nav>

<!-- 2. BREADCRUMB ĐIỀU HƯỚNG -->
<div class="bg-light border-bottom py-2">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 extra-small">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-secondary">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/#products-grid" class="text-decoration-none text-secondary">Sản phẩm</a></li>
                <li class="breadcrumb-item"><span class="text-secondary">@Model.Category</span></li>
                <li class="breadcrumb-item active fw-semibold text-dark" aria-current="page">@Model.Code</li>
            </ol>
        </nav>
    </div>
</div>

<!-- 3. KHU VỰC CHI TIẾT SẢN PHẨM CHÍNH (2 CỘT: TRÁI ẢNH - PHẢI THÔNG TIN) -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row g-4 g-lg-5 align-items-start">

            <!-- CỘT TRÁI: HÌNH ẢNH SẢN PHẨM -->
            <div class="col-lg-5">
                <div class="card border rounded-4 shadow-sm overflow-hidden bg-light position-relative">
                    @if (Model.IsFeatured)
                    {
                        <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill fw-bold shadow-sm z-1">
                            ★ Mẫu tiêu biểu xuất khẩu
                        </span>
                    }

                    <div class="product-detail-img-wrapper d-flex align-items-center justify-content-center" style="aspect-ratio: 1 / 1; overflow: hidden;">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name" class="w-100 h-100 object-fit-cover product-zoom-img" />
                        }
                        else
                        {
                            <div class="text-center text-muted p-5">
                                <span style="font-size: 4rem;">🧦</span>
                                <p class="small mt-2 mb-0">Hình ảnh đang được cập nhật</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Nhãn chứng nhận chất lượng bên dưới ảnh -->
                <div class="row g-2 mt-3 text-center">
                    <div class="col-4">
                        <div class="border rounded-3 py-2 px-1 bg-light">
                            <div class="fw-bold text-primary extra-small">ISO 9001:2015</div>
                            <div class="text-muted" style="font-size: 0.7rem;">Quản lý chất lượng</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="border rounded-3 py-2 px-1 bg-light">
                            <div class="fw-bold text-success extra-small">OEKO-TEX®</div>
                            <div class="text-muted" style="font-size: 0.7rem;">An toàn sợi dệt</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="border rounded-3 py-2 px-1 bg-light">
                            <div class="fw-bold text-dark extra-small">OEM / ODM</div>
                            <div class="text-muted" style="font-size: 0.7rem;">Gia công theo mẫu</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: THÔNG TIN KỸ THUẬT & BÁO GIÁ -->
            <div class="col-lg-7">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1.5 rounded-pill fw-semibold">
                        @Model.Category
                    </span>
                    <span class="badge bg-dark text-white px-3 py-1.5 rounded-pill fw-semibold">
                        SKU: @Model.Code
                    </span>
                </div>

                <h1 class="h2 fw-bold text-dark mb-3">@Model.Name</h1>

                <p class="text-secondary lh-base mb-4">
                    @(string.IsNullOrEmpty(Model.Description)
                        ? "Sản phẩm được dệt trên hệ thống máy dệt kim tự động công nghệ cao tại nhà máy Supertex, đảm bảo độ co giãn chuẩn xác, đường may mũi tất êm ái và độ bền màu đạt tiêu chuẩn xuất khẩu quốc tế."
                        : Model.Description)
                </p>

                <!-- Bảng thông số kỹ thuật chi tiết -->
                <div class="card border-0 bg-light rounded-4 p-3 p-md-4 mb-4">
                    <h6 class="fw-bold text-dark text-uppercase small mb-3 tracking-wider">
                        Thông số kỹ thuật tiêu chuẩn
                    </h6>
                    <div class="table-responsive">
                        <table class="table table-borderless table-sm mb-0 align-middle">
                            <tbody>
                                <tr class="border-bottom border-secondary-subtle">
                                    <td class="text-muted py-2.5" style="width: 35%;">Mã sản phẩm (SKU):</td>
                                    <td class="fw-bold text-danger py-2.5">@Model.Code</td>
                                </tr>
                                <tr class="border-bottom border-secondary-subtle">
                                    <td class="text-muted py-2.5">Phân loại danh mục:</td>
                                    <td class="fw-semibold text-dark py-2.5">@Model.Category</td>
                                </tr>
                                <tr class="border-bottom border-secondary-subtle">
                                    <td class="text-muted py-2.5">Thành phần chất liệu:</td>
                                    <td class="fw-semibold text-dark py-2.5">@(string.IsNullOrEmpty(Model.Material) ? "Combed Cotton / Spandex / Polyester (Tùy chỉnh theo đơn)" : Model.Material)</td>
                                </tr>
                                <tr class="border-bottom border-secondary-subtle">
                                    <td class="text-muted py-2.5">Kích cỡ (Size):</td>
                                    <td class="fw-semibold text-dark py-2.5">@(string.IsNullOrEmpty(Model.Size) ? "Free Size / Kids / Adult (Sản xuất theo thông số khách hàng)" : Model.Size)</td>
                                </tr>
                                <tr class="border-bottom border-secondary-subtle">
                                    <td class="text-muted py-2.5">Màu sắc:</td>
                                    <td class="fw-semibold text-dark py-2.5">@(string.IsNullOrEmpty(Model.Color) ? "Đa dạng màu sắc theo bảng màu Pantone" : Model.Color)</td>
                                </tr>
                                <tr>
                                    <td class="text-muted py-2.5">Hình thức hợp tác:</td>
                                    <td class="fw-semibold text-primary py-2.5">Gia công OEM / ODM xuất khẩu (Nhật Bản, Mỹ, EU)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Nút hành động B2B (Đã thu nhỏ gọn gàng, đồng bộ tiếng Việt và trỏ đúng link tự động ghim SKU) -->
                <div class="d-flex flex-wrap gap-2">
                    <a href="/Home/RequestQuote?code=@Model.Code" class="btn btn-primary px-3 py-2 rounded-3 fw-semibold shadow-sm text-center small">
                        <i class="fa-solid fa-file-invoice-dollar me-1"></i> Gửi yêu cầu báo giá mẫu @Model.Code
                    </a>
                    <a href="/Home/RequestSample?code=@Model.Code" class="btn btn-outline-dark px-3 py-2 rounded-3 fw-semibold text-center small">
                        <i class="fa-solid fa-box-open me-1"></i> Đăng ký nhận mẫu thử
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- 4. PHẦN BỔ SUNG PHÍA DƯỚI: DỊCH VỤ TÙY CHỈNH OEM/ODM -->
<section class="py-5 bg-light border-top border-bottom">
    <div class="container">
        <div class="text-center mb-4">
            <span class="text-uppercase text-primary fw-bold extra-small tracking-wider">OEM & ODM CAPABILITIES</span>
            <h4 class="fw-bold text-dark mt-1">Tùy Chỉnh Sản Xuất Theo Thương Hiệu Của Bạn</h4>
            <p class="text-muted small mb-0">Supertex hỗ trợ phát triển mẫu trọn gói từ ý tưởng thiết kế đến đóng gói xuất khẩu</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4">
                    <div class="fs-2 mb-2">🧵</div>
                    <h6 class="fw-bold text-dark">Tùy chọn nguyên liệu sợi</h6>
                    <p class="text-secondary small mb-0">
                        Đa dạng nguồn sợi đạt chuẩn quốc tế: Combed Cotton, Organic Cotton, sợi tre Bamboo kháng khuẩn, Merino Wool, sợi tái chế Recycled Poly...
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4">
                    <div class="fs-2 mb-2">🏷️</div>
                    <h6 class="fw-bold text-dark">Dệt Logo & Bao bì riêng</h6>
                    <p class="text-secondary small mb-0">
                        Hỗ trợ dệt Jacquard họa tiết sắc nét, thêu logo thương hiệu, in chống trượt silicone đế tất và thiết kế tem nhãn, hộp đóng gói theo chuẩn bán lẻ.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4">
                    <div class="fs-2 mb-2">🔍</div>
                    <h6 class="fw-bold text-dark">Kiểm định QC 100%</h6>
                    <p class="text-secondary small mb-0">
                        Mỗi lô hàng đều trải qua quy trình kiểm tra kích thước, độ co giãn, dò kim loại (Metal Detector) nghiêm ngặt đáp ứng tiêu chuẩn thị trường Nhật Bản & Mỹ.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 5. SẢN PHẨM LIÊN QUAN (NẾU CÓ TRONG DATABASE) -->
@if (relatedProducts != null && relatedProducts.Any())
{
    <section class="py-5 bg-white">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="fw-bold text-dark mb-1">Sản Phẩm Khác Của Supertex</h4>
                    <p class="text-muted small mb-0">Tham khảo thêm các dòng tất xuất khẩu tiêu biểu</p>
                </div>
                <a href="/#products-grid" class="btn btn-outline-dark btn-sm rounded-pill px-3">Xem tất cả &rarr;</a>
            </div>

            <div class="row g-3 g-md-4">
                @foreach (var item in relatedProducts)
                {
                    <div class="col-6 col-md-3">
                        <div class="card h-100 border-0 rounded-4 shadow-sm overflow-hidden modern-product-card">
                            <a href="/Home/Details/@item.Id" class="text-decoration-none text-dark">
                                <div class="bg-light border-bottom position-relative overflow-hidden" style="aspect-ratio: 1 / 1;">
                                    <span class="badge bg-dark bg-opacity-75 text-white position-absolute top-0 start-0 m-2 rounded-pill px-2 py-1 extra-small">
                                        @item.Code
                                    </span>
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" class="w-100 h-100 object-fit-cover" />
                                    }
                                    else
                                    {
                                        <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                                            <span class="fs-1">🧦</span>
                                        </div>
                                    }
                                </div>
                                <div class="card-body p-3">
                                    <div class="text-primary extra-small fw-semibold mb-1">@item.Category</div>
                                    <h6 class="fw-bold text-dark small text-truncate mb-1" title="@item.Name">@item.Name</h6>
                                    <div class="text-muted extra-small text-truncate">
                                        @(string.IsNullOrEmpty(item.Material) ? "Standard Cotton" : item.Material)
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<style>
    .product-zoom-img {
        transition: transform 0.35s ease;
    }

    .product-detail-img-wrapper:hover .product-zoom-img {
        transform: scale(1.06);
    }
</style>