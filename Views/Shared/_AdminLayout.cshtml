<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị hệ thống Supertex</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
            body {
                font-family: 'Inter', sans-serif;
                background-color: #f1f5f9;
                color: #1e293b;
            }
            /* Top Header nhận diện */
            .admin-top-header {
                background-color: #0f172a;
                color: #ffffff;
                border-bottom: 1px solid #334155;
            }
            /* Sidebar Menu bên trái - Cải tiến nổi bật, có chiều sâu */
            .admin-sidebar {
                min-height: calc(100vh - 65px);
                background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
                border-right: 1px solid #e2e8f0;
                box-shadow: inset -2px 0 5px rgba(0, 0, 0, 0.01);
            }
                /* Tiêu đề nhóm chính trong Sidebar (Được làm nổi bật, sang trọng hơn) */
                .admin-sidebar .sidebar-heading {
                    font-size: 0.78rem;
                    font-weight: 800;
                    text-align: left;
                    color: #1e293b;
                    background: linear-gradient(90deg, #e2e8f0 0%, #f1f5f9 100%);
                    padding: 0.5rem 0.75rem;
                    border-radius: 0.35rem;
                    margin-top: 1.25rem;
                    margin-bottom: 0.5rem;
                    letter-spacing: 0.8px;
                    text-transform: uppercase;
                    border-left: 4px solid #2563eb;
                }

                    .admin-sidebar .sidebar-heading:first-child {
                        margin-top: 0.25rem;
                    }
                /* Các mục menu con bên dưới */
                .admin-sidebar .nav-link {
                    color: #475569;
                    font-weight: 500;
                    font-size: 0.9rem;
                    padding: 0.6rem 0.85rem;
                    border-radius: 0.5rem;
                    margin-bottom: 0.25rem;
                    transition: all 0.2s ease;
                }

                    .admin-sidebar .nav-link:hover, .admin-sidebar .nav-link.active {
                        color: #2563eb;
                        background-color: #eff6ff;
                        font-weight: 600;
                        transform: translateX(3px);
                    }

                    .admin-sidebar .nav-link i {
                        width: 24px;
                        text-align: center;
                        margin-right: 6px;
                    }
            /* Nội dung chính */
            .admin-content {
                padding: 2rem;
            }
            /* Footer nhỏ gọn */
            .admin-footer {
                background-color: #ffffff;
                border-top: 1px solid #e2e8f0;
                font-size: 0.85rem;
                color: #64748b;
            }
    </style>
</head>
<body>

    <!-- 1. HEADER TRÊN CÙNG -->
    <header class="admin-top-header py-3 px-4 shadow-sm">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <a href="/Admin" class="text-decoration-none text-white fw-bold fs-5 d-flex align-items-center gap-2">
                    <img src="~/images/partners/supertex-logo.svg" alt="Supertex Logo" width="34" class="bg-white rounded p-1 img-fluid" />
                    SUPERTEX <span class="badge bg-primary fs-6 fw-normal ms-2">Admin Panel</span>
                </a>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="text-secondary small d-none d-md-inline">Xin chào, <strong>Quản trị viên</strong></span>
                <a href="/" target="_blank" class="btn btn-outline-light btn-sm px-3">
                    <i class="fa-solid fa-globe me-1"></i> Xem Website
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm">
                        Đăng xuất
                    </button>
                </form>
            </div>
        </div>
    </header>

    <!-- 2. KHUNG CHÍNH -->
    <div class="container-fluid">
        <div class="row">

            <!-- SIDEBAR MENU BÊN TRÁI -->
            <nav class="col-md-3 col-lg-2 d-md-block admin-sidebar p-3 collapse">
                <div class="position-sticky">

                    <!-- Nhóm 1 -->
                    <div class="sidebar-heading">Quản trị chung</div>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" || ViewContext.RouteData.Values["action"]?.ToString() == "Admin" ? "active" : "")" href="/Admin">
                                <i class="fa-solid fa-chart-pie"></i> Tổng quan hệ thống
                            </a>
                        </li>
                    </ul>

                    <!-- Nhóm 2 -->
                    <div class="sidebar-heading">Nội dung trang chủ</div>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Hero" ? "active" : "")" href="/Admin/Hero">
                                <i class="fa-solid fa-image"></i> Banner đầu trang
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")" href="/Admin/HomeAbout">
                                <i class="fa-solid fa-building-shield"></i> Giới thiệu & Năng lực
                            </a>
                        </li>
                    </ul>

                    <!-- Nhóm 3 -->
                    <div class="sidebar-heading">Quản lý kinh doanh</div>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ProductAdmin" || ViewContext.RouteData.Values["action"]?.ToString()?.Contains("Product") == true ? "active" : "")" href="/Admin/Products">
                                <i class="fa-solid fa-box-archive"></i> Danh mục sản phẩm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Activities" ? "active" : "")" href="/Admin/Posts">
                                <i class="fa-solid fa-newspaper"></i> Hoạt động & Tin tức
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "CustomerRequests" ? "active" : "")" href="/Admin/CustomerRequests">
                                <i class="fa-solid fa-envelope-open-text"></i> Yêu cầu báo giá
                            </a>
                        </li>
                    </ul>

                </div>
            </nav>

            <!-- KHUNG HIỂN THỊ NỘI DUNG CHÍNH -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- 3. FOOTER QUẢN TRỊ -->
    <footer class="admin-footer py-3 px-4 text-center text-md-start">
        <div class="container-fluid d-md-flex justify-content-between align-items-center">
            <div>&copy; 2026 <strong>Supertex Hosiery Manufacturing</strong>. All rights reserved.</div>
            <div class="text-muted small mt-2 mt-md-0">Hệ thống quản trị nội bộ phiên bản 2.0 (ASP.NET Core MVC)</div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>